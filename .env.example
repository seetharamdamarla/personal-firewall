# ================================================
# Personal Firewall — Environment Variables
# ================================================
# Copy this file to .env and fill in your values

# ── Lab Network IPs ──
UBUNTU_SERVER_IP=<YOUR_UBUNTU_SERVER_IP>
KALI_IP=<YOUR_KALI_ATTACKER_IP>
GATEWAY_IP=<YOUR_NETWORK_GATEWAY_IP>

# ── Ubuntu Server Network Interface ──
SNIFFER_IFACE=<YOUR_NETWORK_INTERFACE> # e.g., eth0 or enp0s1

# ── API Keys (Phase 5) ──
ABUSEIPDB_API_KEY=<YOUR_ABUSEIPDB_API_KEY>
SHODAN_API_KEY=<YOUR_SHODAN_API_KEY>

# ── Splunk (Phase 4) ──
SPLUNK_HOST=<YOUR_SPLUNK_SERVER_IP>
SPLUNK_PORT=8089
SPLUNK_USER=<YOUR_SPLUNK_USERNAME>
SPLUNK_PASS=<YOUR_SPLUNK_PASSWORD>

# ── Wazuh (Phase 3) ──
WAZUH_API_HOST=<YOUR_WAZUH_SERVER_IP>
WAZUH_API_PORT=55000
WAZUH_API_USER=<YOUR_WAZUH_USERNAME>
WAZUH_API_PASS=<YOUR_WAZUH_PASSWORD>
